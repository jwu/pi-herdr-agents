{
  "name": "pi-herdr-core",
  "version": "0.1.0",
  "description": "Core Pi extension package for Herdr integrations.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "herdr",
    "extension"
  ],
  "author": "jwu",
  "license": "MIT",
  "files": [
    "extensions/",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bun tsc --noEmit",
    "lint": "bun run format:check && bun run typecheck",
    "format": "prettier --write '{extensions,tests}/**/*.ts'",
    "format:check": "prettier --check '{extensions,tests}/**/*.ts'"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.6.0",
    "typebox": "^1.3.27"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.6.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.3.0",
    "prettier": "^3.8.3",
    "typebox": "^1.3.27",
    "typescript": "^6.0.3"
  }
}
